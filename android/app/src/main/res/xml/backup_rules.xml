<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower. The encrypted DB and the secure-storage prefs that
     hold its key stay out of OS backups; Keystore keys can't be restored on
     another phone anyway. Same behaviour as iOS. -->
<full-backup-content>
    <exclude domain="file" path="db/" />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
